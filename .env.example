# Supabase — used by the Votes lens (/votes) for read-only public-record data.
# Vite only exposes vars prefixed with VITE_ to the browser.
# Copy to .env.local (gitignored) and fill in. Use the ANON / publishable key,
# never the service_role key — the anon key is safe for the browser and reads
# go through the "Public read" RLS policy.
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-or-publishable-key>
